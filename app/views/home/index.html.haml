- unless @external_page
  :css
    #tagline:before { background-image: url("#{ContentConfig.url_for(:home_hero)}") }


- content_for :page_alert do
  = render "shared/menu/alert"

%div
  - if @external_page
    = render "home/external_page", page: @external_page
  - else
    = render "home/tagline"

    #panes
      = render "home/brandstory"
      = render "home/system"
      = render "home/cta"
      = render "home/stats"

  = render "shared/footer"
