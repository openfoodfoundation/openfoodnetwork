-# locals: (product:, product_view:)
- available_variant_ids = product_view&.variants&.map(&:id)
.row
  .columns.product-header
    %h3= product.name
    - if product_view
      %span
        %em
          = t("products_from")
        %span= product_producer_name(product_view)
    %br
    - if product.description
      .product-description{ 'data-controller': "add-blank-to-link" }
        %p.text-small
          -# description is sanitized in Spree::Product#description method
          = product.description.html_safe
.row.product-body
  .columns.small-12.medium-4.large-3.product-images
    - carousel_images = product_carousel_images_data(product, available_variant_ids:)
    - has_images = product_carousel_images?(product, available_variant_ids:)
    = render ThumbnailCarouselComponent.new(images: carousel_images, class: (has_images ? nil : "placeholder"))
  .columns.small-12.medium-8.large-9.product-variants
    - if product_view
      = render ShopVariantListComponent.new(product: product_view, variants_in_cart: @variants_in_cart, low_stock_display: @low_stock_display)
    - elsif @order_cycles.many?
      %p.no-variants= t("products_choose_order_cycle")
    - else
      %p.no-variants= t("products_unavailable")
