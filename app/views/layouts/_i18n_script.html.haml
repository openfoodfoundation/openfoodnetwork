-# Skip when the JS bundles didn't run, e.g. an interrupted page load,
-# rather than raising a misleading "I18n is not defined" error.
:javascript
  if (window.I18n) {
    I18n.default_locale = "#{I18n.default_locale}";
    I18n.base_locale = "#{I18n.locale.to_s.split('_').first}";
    I18n.locale = "#{I18n.locale}";
    I18n.fallbacks = true;
  }
