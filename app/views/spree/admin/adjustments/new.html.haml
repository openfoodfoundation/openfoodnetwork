= render partial: 'spree/admin/shared/order_page_title'
= render partial: 'spree/admin/shared/order_tabs', locals: { current: 'Adjustments' }

- content_for :page_title do
  %i.icon-arrow-right
  = t("spree.new_adjustment")

- content_for :page_actions do
  %li= button_link_to t("spree.back_to_adjustments_list"), admin_order_adjustments_url(@order), :icon => 'icon-arrow-left'

= render :partial => 'spree/shared/error_messages', :locals => { :target => @adjustment }

= form_for @adjustment, :url => admin_order_adjustments_path do |f|
  %fieldset.no-border-top
    = render :partial => 'form', :locals => { :f => f }
    .filter-actions.actions
      = button t("spree.continue"), 'icon-arrow-right'
      = button_link_to t("spree.actions.cancel"), admin_order_adjustments_url(@order), :icon => 'icon-remove'
