-# locals: (imageable:)
.field.image-upload-field
  = label_tag nil, t('.label')
  - unless imageable.image.present?
    %span.info= t('.subtitle')
  .image-upload{ class: ("image-upload--has-image" if imageable.image.present?) }
    - if imageable.image.present?
      %a.image-upload__link{ href: image_form_path(imageable) }
        = image_tag imageable.image.url(:product), alt: imageable.image.alt, class: "image-upload__preview"
        .button.secondary.image-upload__button= t('.edit')
    - else
      .image-upload__controls{ data: { controller: "upload-image",
                                       "upload-image-url-value": image_upload_path(imageable),
                                       "upload-image-viewable-id-value": imageable.id } }
        = label_tag nil, t('.upload'), for: "image-upload-input-#{imageable.id}", class: "button secondary image-upload__button"
        = file_field_tag "image[attachment]", accept: "image/*", id: "image-upload-input-#{imageable.id}",
          class: "image-upload__input",
          "data-action": "change->upload-image#upload"
