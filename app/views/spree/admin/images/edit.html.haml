= render partial: 'spree/admin/shared/product_sub_menu'

-# The admin layout has no viewport meta tag, so phones lay this page out at
-# ~980px and scale it down. Opt this page in so its small-screen styles apply.
- content_for :head do
  %meta{ name: "viewport", content: "width=device-width, initial-scale=1" }

- content_for :page_class do
  image-edit-page

- content_for :page_title do
  = t('spree.admin.images.edit.title', resource_name: image_modal_resource_name(@variant, @product))

= render partial: 'spree/shared/error_messages', locals: { target: @error_target || @image }

-# Saving, replacing or deleting from this page all return to the page that owns the image,
-# which is also where Cancel goes.
- owner_edit_path = image_owner_edit_path(@product, @variant)

-# A replacement file is only previewed here; it's persisted when the form is saved.
.image-edit{ data: { controller: "image-preview" } }
  .image-edit__preview
    = image_tag @image.url(:large), alt: @image.alt, class: "image-edit__preview-image",
      data: { "image-preview-target": "preview" }
  .image-edit__panel
    = form_for [:admin, @product, @image], url: admin_product_image_path(@product, @image, @url_filters), html: { multipart: true } do |f|
      = hidden_field_tag :variant_id, @variant.id if @variant
      = hidden_field_tag :return_url, owner_edit_path
      = f.hidden_field :viewable_id, value: @variant ? @variant.id : @product.id

      %p.image-edit__filename
        %span.image-edit__filename-label= "#{t('spree.filename')}:"
        %span.image-edit__filename-value{ data: { "image-preview-target": "filename" } }
          = @image.attachment.filename

      .field
        = f.label :caption, t('spree.caption')
        = f.text_field :caption, class: "fullwidth",
          value: @image.caption.presence || default_image_caption(@product, @variant)

      .field
        = f.label :alt, t('spree.alt_text')
        = f.text_area :alt, rows: 4, class: "fullwidth image-edit__alt"

      .image-edit__actions
        = f.file_field :attachment, accept: "image/*", class: "image-edit__input sr-only",
          "data-action": "change->image-preview#update"
        = f.label :attachment, t('spree.replace_image'), class: "image-edit__link image-edit__link--replace"

        - delete_url_options = @url_filters.merge(return_url: owner_edit_path)
        - delete_url_options.merge!(variant_id: @variant.id) if @variant
        = link_to t('spree.delete_permanently'),
            admin_product_image_path(@product, @image, delete_url_options),
            method: :delete,
            class: "image-edit__link image-edit__link--delete"

      .image-edit__buttons
        = link_to t('spree.actions.cancel'), owner_edit_path, class: "button secondary"
        = button t('spree.actions.save')
