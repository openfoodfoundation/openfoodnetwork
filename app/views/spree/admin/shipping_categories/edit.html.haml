= render :partial => 'spree/admin/shared/configuration_menu'

- content_for :page_title do
  = t("spree.editing_shipping_category")

- content_for :page_actions do
  %li
    = button_link_to t("spree.back_to_shipping_categories"), admin_shipping_categories_path, :icon => 'icon-arrow-left'

= render :partial => 'spree/shared/error_messages', :locals => { :target => @shipping_category }

= form_for [:admin, @shipping_category] do |f|
  %fieldset.no-border-top
    = render :partial => 'form', :locals => { :f => f }
    = render :partial => 'spree/admin/shared/edit_resource_links'
