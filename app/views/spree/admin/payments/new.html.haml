= render partial: 'spree/admin/shared/order_page_title'
= render partial: 'spree/admin/shared/order_tabs', locals: { current: 'Payments' }

- content_for :page_title do
  %i.icon-arrow-right
  = t("spree.new_payment")

- content_for :page_actions do
  %li= button_link_to t("spree.back_to_payments_list"), admin_order_payments_url(@order), icon: 'icon-arrow-left'

- if @payment_methods.any?
  = render partial: 'spree/shared/error_messages', locals: { target: @payment }

  = form_for @payment, url: admin_order_payments_path(@order), html: {"ng-app" => "admin.payments", "ng-controller" => "PaymentCtrl"} do |f|
    %save-bar{ persist: "true" }
    %fieldset.no-border-top
      = render partial: 'form', locals: { f: f }
      .filter-actions.actions
        = button_tag t(:update), type: 'button', "ng-click" => "submitPayment()"

- else
  = t("spree.cannot_create_payment_without_payment_methods")
  = link_to t("spree.please_define_payment_methods"), admin_payment_methods_url
