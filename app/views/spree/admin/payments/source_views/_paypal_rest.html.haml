%fieldset
  %legend{align: "center"}= I18n.t('spree.paypal.transaction')
  .row
    .alpha.six.columns
      %dl
        %dt
          = I18n.t('spree.paypal.order_id')
          \:
        %dd= payment.source.order_id
        %dt
          = I18n.t('spree.paypal.capture_id')
          \:
        %dd= payment.source.capture_id
        %dt
          = I18n.t('spree.paypal.payer_id')
          \:
        %dd= payment.source.payer_id
        %dt
          = I18n.t('spree.paypal.refund_id')
          \:
        %dd= payment.source.refund_id
        %dt
          = I18n.t('spree.paypal.status')
          \:
        %dd= payment.source.status
