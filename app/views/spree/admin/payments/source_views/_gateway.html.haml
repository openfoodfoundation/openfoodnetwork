%fieldset
  %legend{:align => "center"}= t("spree.credit_card")
  .row
    .alpha.six.columns
      %dl
        %dt
          = t("spree.card_number")
          \:
        %dd= payment.source&.display_number
        %dt
          = t("spree.expiration")
          \:
        %dd
          = payment.source&.month
          \/
          = payment.source&.year
        %dt
          = t("spree.card_code")
          \:
        %dd= payment.source&.verification_value
    .omega.six.columns
      %dl
        %dt
          = t(:maestro_or_solo_cards)
          \:
        %dd= payment.source&.issue_number
        %dt
          = t("spree.start_date")
          \:
        %dd
          = payment.source&.start_month
          \/
          = payment.source&.start_year
