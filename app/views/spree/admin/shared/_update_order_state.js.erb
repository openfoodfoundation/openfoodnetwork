$('#order_tab_summary h5#order_status').html('<%= j t("spree.status") %>: <%= j t(@order.state, scope: [:spree, :order_state]) %>');
$('#order_tab_summary h5#order_total').html('<%= j t("spree.total") %>: <%= j @order.display_total.to_html %>');

<% if @order.completed? %>
  $('#order_tab_summary h5#payment_status').html('<%= j t("spree.payment") %>: <%= j t(@order.payment_state, scope: [:spree, :payment_states], default: [:missing, "none"]) %>');
  $('#order_tab_summary h5#shipment_status').html('<%= j t("spree.shipment") %>: <%= j t(@order.shipment_state, scope: [:spree, :shipment_state], default: [:missing, "none"]) %>');
<% end %>
