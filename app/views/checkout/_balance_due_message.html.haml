- balance_due_service = Orders::BalanceDueService.new(@order)
- balance_due_adjustment = balance_due_service.adjustment
- if balance_due_adjustment
  - order_links = balance_due_service.carried_over_orders.map { |order| link_to(order.number, order_path(order.number), target: "_blank", rel: "noopener") }
  %p.balance-due-message
    = t("checkout.balance_due_message_html", amount: balance_due_adjustment.display_amount, order_numbers: safe_join(order_links, ", "))
