= render partial: 'shared/mailers/greeting_and_intro',
         locals: { greeting: enterprise_greeting(@order.distributor.contact_name),
                   intro: t(".intro"),
                   enterprise_for_logo: @order.distributor }

%p= t ".hints"
%p= t ".order", number: @order.number

%table
  %tr
    %th= t ".stock"
    %th= t ".product"

  - @linked_variants.each do |variant|
    %tr
      %td= variant.on_hand
      %td= variant.product_and_full_name
