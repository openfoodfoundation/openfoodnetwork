- # NOTE: make sure that any changes in this template are reflected in app/views/admin/products_v3/product_preview.turbo_stream.haml
:ruby
  product_pages = product_pages?(current_distributor)
  product_link = if product_pages
    # AngularJS fills in the product. Path helpers would escape its braces.
    { "ng-href" => main_app.enterprise_product_path(current_distributor, "PRODUCT").sub("PRODUCT", "{{::product.to_param}}"),
      "data-action" => "product-page-overlay#open" }
  else
    { "data-controller" => "shop-product-modal", "data-action" => "click->shop-product-modal#open", "ng-attr-data-shop-product-modal-url-value" => "/shop/product_modal?product_id={{::product.id}}&order_cycle_id={{order_cycle.order_cycle_id}}" }
  end

= cache_with_locale(([:product_pages, current_distributor.permalink] if product_pages)) do
  .product-thumb
    %a{ product_link }
      %span.product-thumb__bulk-label{"ng-if" => "::product.group_buy"}
        = t(".bulk")
      %img{"ng-src" => "{{::product.primaryImageOrMissing}}"}

  .summary
    .summary-header
      %h3
        %a{ product_link }
          %span{"ng-bind" => "::product.name"}
      -# The description can contain links of its own, so it can't be a link to the product page.
      - if product_pages
        .product-description{
          "data-controller": "add-blank-to-link",
          "ng-bind-html": "::product.description_html",
          "ng-show": "product.description_html.length"
        }
      - else
        .product-description{
          "data-controller": "add-blank-to-link shop-product-modal",
          "data-action": "click->shop-product-modal#open",
          "ng-attr-data-shop-product-modal-url-value" => "/shop/product_modal?product_id={{::product.id}}&order_cycle_id={{order_cycle.order_cycle_id}}",
          "ng-bind-html": "::product.description_html",
          "ng-show": "product.description_html.length"
        }
      %div{ "ng-switch" => "enterprise.visible" }
        .product-producer
          = t :products_from
          %span{ "ng-switch-when": "hidden", "ng-bind" => "::enterprise.name"}
          %span{ "ng-switch-default": true }
            %enterprise-modal{"ng-bind" => "::enterprise.name"}

      .product-properties.filter-shopfront.property-selectors
        %filter-selector{ 'selector-set' => "productPropertySelectors", objects: "[product] | propertiesWithValuesOf" }
