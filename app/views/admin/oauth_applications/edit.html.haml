= render "spree/admin/shared/configuration_menu"

- content_for :page_title do
  = t(".title", name: @application.name)

%fieldset.no-border-bottom
  %legend{ align: "center" }= t(".credentials")
  .field
    = label_tag :oauth_application_uid, t(".uid")
    = text_field_tag :oauth_application_uid, @application.uid, readonly: true, class: "fullwidth"
  .field
    = label_tag :oauth_application_secret, t(".secret")
    = text_field_tag :oauth_application_secret, @application.secret, readonly: true, class: "fullwidth"
  %p.text-muted= t(".endpoints", authorize: main_app.oauth_authorization_url, token: main_app.oauth_token_url, userinfo: main_app.oauth_userinfo_url)

= render "form", url: main_app.admin_oauth_application_path(@application), submit_label: t(:update)
