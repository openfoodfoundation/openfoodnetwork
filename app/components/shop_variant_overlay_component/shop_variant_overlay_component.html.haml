%div{ "data-controller": "shop-variant-overlay" }
  = button_tag t("shopfront.variant.select"), type: "button", class: "select-variant primary", "data-action": "shop-variant-overlay#select"

  - if variants.length > 1
    %div{ "data-action": "keyup@document->shop-variant-overlay#closeIfEscapeKey" }
      .variant-overlay-bg.fade{ "data-shop-variant-overlay-target": "background", "data-action": "click->shop-variant-overlay#close" }
      .variant-overlay{ "data-shop-variant-overlay-target": "element" }
        - # Loop through variant
        %ul
          - variants.each do |variant|
            %li=variant.display_name || variant.product.name
        %input{ class: "button", type: 'button', value: t('js.admin.modals.close'), "data-action": "click->shop-variant-overlay#close" }
