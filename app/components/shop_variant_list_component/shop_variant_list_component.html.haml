%ul.variant-list
  - variants.each do |variant|
    %li
      .row
        .small-8.columns
          - if variant.display_name.present?
            .variant-columns.variant-name= variant.name_to_display
          .variant-columns.variant-unit= unit_to_display(variant)
          - unless single_producer?
            .variant-producer= producer_name(variant)
          .prices
            %span.price
              = variant.display_price_with_fees
              = render InfoPopoverComponent.new(id: "price-breakdown-#{variant.id}", label: t("js.shopfront.price_breakdown"), css_class: "price-breakdown") do
                %h6= t("js.shopfront.price_breakdown")
                %dl
                  %div
                    %dt= t(:item_cost)
                    %dd= display_money(variant.price)
                  - fee_breakdown(variant).each do |name, amount|
                    %div
                      %dt= name
                      %dd= display_money(amount)
                  .total
                    %dt
                    %dd= "= #{variant.display_price_with_fees}"
            %span.unit-price
              = helpers.unit_price_with_unit(variant)
              = render InfoPopoverComponent.new(id: "unit-price-info-#{variant.id}", label: t("components.shop_variant_list.unit_price_info"), placement: "top") do
                = t("js.shopfront.unit_price_tooltip")
        .small-4.columns
          = render AddToCartComponent.new(variant:, quantity: variants_in_cart[variant.id], low_stock_display:, css_class: "right", cart_params:)
