-# locals: (product:, variants_in_cart:, low_stock_display:)

.product-item
  .product-content
    -# The grid is a turbo frame, which would load the product page into itself.
    %a.product-link{ href: product_path, "data-turbo-frame": "_top" }
      - if product.image
        = image_tag(product.image.url(:small), alt: product.image.alt, title: product.image.alt)
      - else
        = image_tag(Spree::Image.default_image_url(:small), class: "placeholder")
      %p.producer= helpers.product_producer_name(product)
      %p.product-name= product_name
      %p.prices
        - unless product.single_variant?
          = t("components.product_tile.from_price")
        %span.price= price
        - if unit_price
          %span.unit-price= unit_price

    .variant
      - if product.single_variant?
        = render AddToCartComponent.new(variant: product.variant, quantity: variants_in_cart[product.variant.id], low_stock_display:)
      - else
        = render ShopVariantModalComponent.new(product:, variants_in_cart:, low_stock_display:)
