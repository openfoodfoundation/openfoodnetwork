#!/usr/bin/env ruby

# Bump the version for the next release and create the tag.
#
# Usage: script/release/tag [major|minor|patch|hotfix]
# Defaults to a patch bump when no argument is given.

BUMP_TYPES = %w[major minor patch hotfix].freeze

bump_type = ARGV[0] || "patch"
unless BUMP_TYPES.include?(bump_type)
  abort "Usage: #{$PROGRAM_NAME} [#{BUMP_TYPES.join('|')}]"
end

puts "\n*** Fetching latest release tag... ***\n"

# Fetch current tags first:
`git fetch upstream --tags`

# Last tag without a newline:
latest_tag = `git tag --list 'v*' --sort v:refname | tail -1`.chomp

# Parse version without the "v" at the start:
latest_version = Gem::Version.new(latest_tag[1..-1])

# Bump the requested version segment:
major, minor, patch, hotfix = latest_version.segments
next_tag =
  case bump_type
  when "major" then "v#{major.succ}.0.0"
  when "minor" then "v#{major}.#{minor.succ}.0"
  when "hotfix" then "v#{major}.#{minor}.#{patch}.#{(hotfix || 0).succ}"
  else "v#{major}.#{minor}.#{patch.succ}"
  end

# Push the new tag
puts "\n*** Pushing new #{bump_type} release tag #{next_tag}... ***\n"
puts `git push upstream 'HEAD:refs/tags/#{next_tag}'`

# Shortcuts
puts "Draft a new release with this tag:
    https://github.com/openfoodfoundation/openfoodnetwork/releases/new?tag=#{next_tag}&title=#{next_tag}+Code+Name"
